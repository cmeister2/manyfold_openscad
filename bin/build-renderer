#!/usr/bin/env python3
"""Verify local renderer assets, or reacquire exactly the locked upstream bytes."""
import argparse
import hashlib
import io
import json
from pathlib import Path
import sys
import tarfile
import urllib.request
import zipfile


def digest(content):
    return hashlib.sha256(content).hexdigest()


def download(url):
    request = urllib.request.Request(url, headers={"User-Agent": "manyfold-openscad-build"})
    with urllib.request.urlopen(request, timeout=120) as response:
        return response.read()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--download", action="store_true", help="download and verify the pinned upstream archives; requires internet access only during this build step")
    parser.add_argument("--verify", action="store_true", help="verify bundled files without network access (the default)")
    args = parser.parse_args()
    target = Path(__file__).resolve().parent.parent / "vendor" / "openscad"
    lock = json.loads((target / "build.lock.json").read_text())
    if args.download:
        acquired = {}
        for archive_key in ["engine_archive", "font_archive"]:
            archive = lock[archive_key]
            content = download(archive["url"])
            if digest(content) != archive["sha256"]:
                raise ValueError(f"Checksum mismatch for {archive_key}; no assets were replaced")
            if archive_key == "engine_archive":
                with zipfile.ZipFile(io.BytesIO(content)) as bundle:
                    for output, member in archive["files"].items():
                        acquired[output] = bundle.read(member)
            else:
                with tarfile.open(fileobj=io.BytesIO(content), mode="r:bz2") as bundle:
                    for output, member in archive["files"].items():
                        acquired[output] = bundle.extractfile(member).read()
        acquired["COPYING"] = download(lock["license_url"])
        for filename, content in acquired.items():
            if digest(content) != lock["sha256"][filename]:
                raise ValueError(f"Checksum mismatch for {filename}; no assets were replaced")
        for filename, content in acquired.items():
            temporary = target / (filename + ".build-tmp")
            temporary.write_bytes(content)
            temporary.replace(target / filename)
    for filename, expected in lock["sha256"].items():
        if digest((target / filename).read_bytes()) != expected:
            raise ValueError(f"Checksum mismatch for {filename}")
    print(f"Verified {lock['build']}: {len(lock['sha256'])} local assets")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"Renderer build failed: {error}", file=sys.stderr)
        sys.exit(1)
